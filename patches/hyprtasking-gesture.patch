diff --git a/src/swipe_motion.hpp b/src/swipe_motion.hpp
new file mode 100644
index 0000000..d6eea1c
--- /dev/null
+++ b/src/swipe_motion.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+// Small, independent gesture primitives; kept unit-testable without Hyprland.
+struct HTSwipeMotion {
+    static bool outside_deadzone(double x, double y, double pixels) {
+        return x * x + y * y >= pixels * pixels;
+    }
+
+    // Decide using accumulated distance. A small initial twitch must not
+    // open the grid during a four-finger horizontal keyboard gesture.
+    static char lock_axis(double x, double y, double minimum, double dominance) {
+        const double ax = x < 0 ? -x : x;
+        const double ay = y < 0 ? -y : y;
+        if (ax >= minimum && ax >= dominance * ay)
+            return 'h';
+        if (ay >= minimum && ay >= dominance * ax)
+            return 'v';
+        return 0;
+    }
+
+    static double clamp_axis(double origin, double delta, double scale,
+                             double min, double max) {
+        const double v = origin + delta * scale;
+        return v < min ? min : (v > max ? max : v);
+    }
+};
diff --git a/tests/gesture_motion_test.cpp b/tests/gesture_motion_test.cpp
new file mode 100644
index 0000000..deff51b
--- /dev/null
+++ b/tests/gesture_motion_test.cpp
@@ -0,0 +1,34 @@
+#include "../src/swipe_motion.hpp"
+#include <cassert>
+#include <cmath>
+
+int main() {
+    assert(!HTSwipeMotion::outside_deadzone(1, 1, 16));
+    assert(!HTSwipeMotion::outside_deadzone(10, 10, 16));
+    assert(HTSwipeMotion::outside_deadzone(16, 0, 16));
+    assert(HTSwipeMotion::outside_deadzone(0, -300, 16));
+    assert(!HTSwipeMotion::outside_deadzone(25, 25, 40));
+    assert(HTSwipeMotion::outside_deadzone(40, 0, 40));
+
+    // A small vertical twitch followed by a strong horizontal swipe must
+    // stay undecided until it clearly becomes horizontal, not open the grid.
+    assert(HTSwipeMotion::lock_axis(0, 9, 28, 1.65) == 0);
+    assert(HTSwipeMotion::lock_axis(18, 11, 28, 1.65) == 0);
+    assert(HTSwipeMotion::lock_axis(40, 11, 28, 1.65) == 'h');
+    assert(HTSwipeMotion::lock_axis(-42, -9, 28, 1.65) == 'h');
+    assert(HTSwipeMotion::lock_axis(9, -35, 28, 1.65) == 'v');
+    assert(HTSwipeMotion::lock_axis(10, 11, 28, 1.65) == 0);
+
+    // The rendered offset depends on net displacement, not clamped steps.
+    const double start = -500, scale = 4, min = -1000, max = 0;
+    assert(HTSwipeMotion::clamp_axis(start, 200, scale, min, max) == 0);
+    assert(HTSwipeMotion::clamp_axis(start, 0, scale, min, max) == start);
+    assert(HTSwipeMotion::clamp_axis(start, -200, scale, min, max) == -1000);
+    assert(HTSwipeMotion::clamp_axis(start, 25, scale, min, max) == -400);
+
+    // At the edge, a clockwise or counter-clockwise loop must go home.
+    const double edge = 0;
+    assert(HTSwipeMotion::clamp_axis(edge, 0, scale, min, max) == edge);
+    assert(HTSwipeMotion::clamp_axis(edge, 300, scale, min, max) == edge);
+    return 0;
+}
