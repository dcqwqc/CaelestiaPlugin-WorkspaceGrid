+typedef void (*render_layer_t)(
+    void* thisptr,
+    PHLLS pLayer,
+    PHLMONITOR pMonitor,
+    const Time::steady_tp& time,
+    bool popups,
+    bool lockscreen
+);
+
+// Global shell layers do not belong to individual workspaces. Rendering them
+// nine times at different scales recreates a full-monitor blur for each tile,
+// producing giant blurry boxes and unnecessary GPU work. Skip only while the
+// compositor draws Hyprtasking's miniature workspace tiles; keep the normal
+// desktop and its blur/panels untouched. Wallpaper layers still draw normally.
+static void hook_render_layer(
+    void* thisptr,
+    PHLLS pLayer,
+    PHLMONITOR pMonitor,
+    const Time::steady_tp& time,
+    bool popups,
+    bool lockscreen
+) {
+    if (hyprtasking_rendering_workspace_tile && pLayer != nullptr) {
+        const auto& name = pLayer->m_namespace;
+        if (name == "caelestia-drawers"
+            || name == "caelestia-area-picker"
+            || name == "caelestia-background"
+            || name == "caelestia-border-exclusion"
+            || name == "quickshell"
+            || name == "loom-agent-cursors"
+            || name == "yoga-osk-toolbar"
+            || name == "yoga-osk-handle")
+            return;
+    }
+
+    ((render_layer_t)(render_layer_hook->m_original))(
+        thisptr, pLayer, pMonitor, time, popups, lockscreen
+    );
+}
